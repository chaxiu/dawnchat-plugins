{
  "name": "@dawnchat/shared-ui",
  "version": "0.2.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/chaxiu/dawnchat-plugins",
    "directory": "shared-ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@dawnchat/shared-protocol": "^0.6.0"
  },
  "peerDependencies": {
    "lucide-vue-next": "^0.562.0",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
