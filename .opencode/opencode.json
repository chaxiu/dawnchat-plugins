{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "agent": {
    "reviewer": {
      "description": "Review code and provide actionable feedback",
      "mode": "primary",
      "steps": 24,
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "rm *": "deny"
        },
        "read": "allow",
        "search": "allow",
        "glob": "allow"
      }
    }
  }
}
