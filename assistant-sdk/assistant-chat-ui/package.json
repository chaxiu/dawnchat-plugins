{
  "name": "@dawnchat/assistant-chat-ui",
  "version": "0.1.0",
  "private": false,
  "description": "Vue 3 Assistant chat timeline UI: message list, tool parts, markdown, permission cards.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chaxiu/dawnchat-plugins",
    "directory": "assistant-sdk/assistant-chat-ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "rm -rf dist && vite build",
    "clean": "rm -rf dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0"
  },
  "peerDependencies": {
    "lucide-vue-next": "^0.562.0",
    "vue": "^3.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.6.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "lucide-vue-next": "^0.562.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4",
    "vue": "^3.5.24",
    "vue-tsc": "^3.2.5"
  }
}
