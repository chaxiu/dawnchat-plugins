{
  "name": "desktop-ai-assistant-vue-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cd ../../../../../assistant-workspace && bun run template:desktop:dev",
    "build": "cd ../../../../../assistant-workspace && bun run template:desktop:build",
    "preview": "cd ../../../../../assistant-workspace && bun run template:desktop:preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run",
    "verify": "bun run typecheck && bun run test:unit && bun run build"
  },
  "// assistant-sdk dependency policy": "Source templates keep assistant SDK on workspace:* and are resolved by dawnchat-plugins/assistant-workspace. DawnChat scaffolder/runtime still rewrites them before user-plugin install or preview.",
  "dependencies": {
    "@dawnchat/assistant-chat-ui": "workspace:*",
    "@dawnchat/assistant-core": "workspace:*",
    "@dawnchat/host-orchestration-sdk": "workspace:*",
    "@vue/runtime-dom": "^3.5.22",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "dexie": "^4.2.1",
    "elkjs": "^0.11.1",
    "jsxgraph": "^1.12.2",
    "lucide-vue-next": "^0.544.0",
    "soundfont-player": "^0.12.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.6.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-vue-inspector": "5.3.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.1.10"
  }
}
