{
  "id": "com.dawnchat.desktop-starter",
  "name": "Desktop Starter",
  "version": "0.1.3",
  "app_type": "desktop",
  "description": "Desktop starter template powered by Vue and Bun backend",
  "author": "DawnChat Team",
  "min_host_version": "1.0.0",
  "permissions": [],
  "capabilities": {
    "tools": []
  },
  "runtime": {
    "backend": "bun",
    "root": "_ir",
    "entry": "backend/entry/main.ts",
    "isolated": false
  },
  "ui": {
    "type": "web",
    "entry": "/",
    "framework": "vue"
  },
  "preview": {
    "frontend_dir": "frontend/web-src"
  },
  "distribution": {
    "packages": [
      "dist",
      "node_modules"
    ]
  },
  "icon": "🧠",
  "tags": [
    "template",
    "desktop",
    "vue",
    "bun"
  ]
}
